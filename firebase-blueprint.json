{
  "entities": {
    "Booking": {
      "title": "Booking",
      "description": "CleanExpert home cleaning reservation document",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "bookingNumber": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 64 },
        "customerPhone": { "type": "string", "maxLength": 32 },
        "address": { "type": "string", "maxLength": 256 },
        "addressDetail": { "type": "string", "maxLength": 256 },
        "postalCode": { "type": "string", "maxLength": 16 },
        "serviceType": { "type": "string", "maxLength": 32 },
        "homeType": { "type": "string", "maxLength": 32 },
        "areaSize": { "type": "string", "maxLength": 32 },
        "options": { "type": "array" },
        "date": { "type": "string", "maxLength": 16 },
        "timeSlot": { "type": "string", "maxLength": 32 },
        "durationHours": { "type": "number" },
        "totalPrice": { "type": "number" },
        "notes": { "type": "string", "maxLength": 500 },
        "entryInfo": { "type": "string", "maxLength": 256 },
        "hasPets": { "type": "boolean" },
        "hasParking": { "type": "boolean" },
        "assignedCleaner": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["pending", "confirmed", "in_progress", "completed", "cancelled"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["bookingNumber", "userId", "customerName", "customerPhone", "address", "serviceType", "date", "timeSlot", "totalPrice", "status"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer service feedback review",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "bookingId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 64 },
        "serviceType": { "type": "string", "maxLength": 32 },
        "areaSize": { "type": "string", "maxLength": 32 },
        "rating": { "type": "number" },
        "content": { "type": "string", "maxLength": 1000 },
        "cleanerName": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "userName", "rating", "content"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered customer profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 64 },
        "phone": { "type": "string", "maxLength": 32 },
        "role": { "type": "string", "enum": ["customer", "admin"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["email", "name"]
    }
  },
  "firestore": {
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Collection of all cleaning service bookings"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Collection of all customer reviews"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Collection of user account profiles"
    }
  }
}
